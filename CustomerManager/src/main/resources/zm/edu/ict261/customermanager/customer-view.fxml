<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="zm.edu.ict261.customermanager.controller.CustomerController"
            styleClass="root-pane">

    <top>
        <VBox>
            <MenuBar>
                <Menu text="_File">
                    <MenuItem text="_Close" onAction="#onClose"/>
                </Menu>
                <Menu text="_Help">
                    <MenuItem text="_About" onAction="#onAbout"/>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Button text="Clear form" onAction="#onClear"/>
                <Button fx:id="deleteButton" text="Delete selected" onAction="#onDelete"/>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="16" right="20" bottom="10" left="20"/>
            </padding>

            <Label text="Customer Manager" styleClass="title"/>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label fx:id="nameLabel" text="Customer name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" promptText="e.g., Mary Banda"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Province" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="provinceBox" promptText="Choose a province" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Button fx:id="saveButton" text="Save customer" onAction="#onSave"
                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <Label fx:id="status" styleClass="status"/>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameCol" text="Customer name" prefWidth="300"/>
                    <TableColumn fx:id="provinceCol" text="Province" prefWidth="200"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <Label text="Tip: press Tab to move between fields and Enter to save. Data is kept in memory only."
               styleClass="hint">
            <padding>
                <Insets top="4" right="20" bottom="10" left="20"/>
            </padding>
        </Label>
    </bottom>
</BorderPane>
